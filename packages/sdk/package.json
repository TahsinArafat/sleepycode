{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.0.29",
  "name": "@sleepy-ai/sdk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./workerd": "./src/workerd.ts",
    "./workerd/effect": "./src/effect/workerd.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "tsgo -b",
    "verify:package": "bun run script/verify-package.ts"
  },
  "dependencies": {
    "@sleepy-ai/client": "workspace:*",
    "@sleepy-ai/core": "workspace:*",
    "@sleepy-ai/plugin": "workspace:*",
    "@sleepy-ai/schema": "workspace:*",
    "@sleepy-ai/server": "workspace:*",
    "@sleepy-ai/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@sleepy-ai/ai": "workspace:*",
    "@sleepy-ai/httpapi-codegen": "workspace:*",
    "@sleepy-ai/protocol": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
