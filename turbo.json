{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": [
    "patches/**",
    "bunfig.toml",
    ".npmrc",
    ".github/actions/setup-bun/**",
    ".github/workflows/test.yml"
  ],
  "globalEnv": ["CI", "SLEEPYCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "SLEEPYCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "@sleepy-ai/cli#typecheck": {
      "dependsOn": ["@sleepy-ai/core#typecheck"]
    },
    "test:components": {
      "outputs": [],
      "cache": false
    },
    "@sleepy-ai/enterprise#typecheck": {
      "dependsOn": ["@sleepy-ai/core#typecheck"]
    },
    "@sleepy-ai/sdk#typecheck": {
      "dependsOn": ["@sleepy-ai/core#typecheck"]
    },
    "@sleepy-ai/server#typecheck": {
      "dependsOn": ["@sleepy-ai/core#typecheck"]
    },
    "@sleepy-ai/simulation#typecheck": {
      "dependsOn": ["@sleepy-ai/core#typecheck"]
    },
    "@sleepy-ai/tui#typecheck": {
      "dependsOn": ["@sleepy-ai/core#typecheck"]
    },
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "@sleepy-ai/ai#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/codemode#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/function#test": {
      "outputs": []
    },
    "@sleepy-ai/desktop#test": {
      "outputs": [],
      "cache": false
    },
    "@sleepy-ai/httpapi-codegen#test": {
      "outputs": []
    },
    "@sleepy-ai/server#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/cli#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/tui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/latex#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@sleepy-ai/sdk#verify:package": {
      "outputs": []
    }
  }
}
